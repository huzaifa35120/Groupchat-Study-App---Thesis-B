# Supabase (Project Settings -> API). The Vercel Supabase integration sets these for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to run migrations (scripts/migrate.mjs)
POSTGRES_URL_NON_POOLING=

# Anthropic API key for Claude Opus 5 predictions and the LLM judge
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to register / sign in as researchers
ADMIN_EMAILS=
